# 中文功能说明：远端模型服务配置模板，定义三个模型服务的开关、地址和超时时间。

MODEL_SERVICES_ENABLED=true
MODEL_SERVICE_TIMEOUT_SEC=8

QUERY_INTENT_ENABLED=true
QUERY_INTENT_SERVICE_URL=http://10.99.24.182:22436
QUERY_INTENT_MODE=auto

QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_BASE_URL=https://ai.wust.edu.cn/gpustack/v1
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_MODEL=qwen3-30b-a3b-instruct
QUERY_REWRITE_MAX_REWRITES=5
QUERY_REWRITE_MAX_TOKENS=1024
QUERY_REWRITE_TIMEOUT_SEC=20
QUERY_REWRITE_VERIFY_SSL=true
QUERY_REWRITE_CACHE_PATH=cost_control_cache/query_rewrite_cache.json

SELECTOR_RERANKER_ENABLED=true
# Current running selector-reranker pod mounts /data/csp/selector-reranker/model
# into /models/selector-reranker and uses threshold 0.0006931035313755274.
SELECTOR_RERANKER_SERVICE_URL=http://10.99.24.182:32082
SELECTOR_RERANKER_POOL_LIMIT=500
SELECTOR_RERANKER_CANDIDATE_LIMIT=120
SELECTOR_RERANKER_PROTECTED_HEAD=0

CRAWLER_STRATEGY_ENABLED=true
CRAWLER_STRATEGY_SERVICE_URL=http://10.99.24.182:32183
CRAWLER_STRATEGY_TOP_N=3
