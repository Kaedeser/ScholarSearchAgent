# Copy to database.env or point SCHOLAR_SEARCH_CONFIG to your own file.
# Do not commit or share real passwords/API keys.

PASA_DATA_ROOT=../../数据集/pasa/data
PROCESSED_DIR=../data_ingestion_indexing/data_processed
LOG_DIR=../data_ingestion_indexing/logs

MYSQL_HOST=10.99.24.182
MYSQL_PORT=48752
MYSQL_DATABASE=scholar_search
MYSQL_USERNAME=root
MYSQL_PASSWORD=

ELASTICSEARCH_URL=http://10.99.24.182:32097
ELASTICSEARCH_USERNAME=kaede
ELASTICSEARCH_PASSWORD=
PAPERS_INDEX=saiti3_papers_v1
CHUNKS_INDEX=saiti3_paper_chunks_v1

NEO4J_HTTP_URL=http://10.99.24.182:30474
NEO4J_BOLT_URL=bolt://10.99.24.182:30687
NEO4J_URI=bolt://10.99.24.182:30687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_GRAPH_NAME=paper
NEO4J_RETRIEVAL_ENABLED=false
NEO4J_MAX_SEED_PAPERS=3
NEO4J_MAX_NEIGHBORS=30
NEO4J_MIN_CONCEPT_CONFIDENCE=0.65

QDRANT_URL=http://10.99.24.182:32333
QDRANT_API_KEY=
QDRANT_COLLECTION=saiti3_paper_chunks_v1
QDRANT_SPARSE_VECTOR_NAME=text
QDRANT_SPARSE_VECTOR_SIZE=65536
QDRANT_SPARSE_PAPER_ENABLED=false
QDRANT_SPARSE_PAPER_COLLECTION=saiti3_papers_sparse_v1
QDRANT_DENSE_PAPER_ENABLED=false
QDRANT_DENSE_PAPER_COLLECTION=saiti3_papers_dense_v1
QDRANT_DENSE_VECTOR_NAME=
QDRANT_DENSE_VECTOR_SIZE=2560
DENSE_EMBEDDING_BACKEND=gpustack
DENSE_EMBEDDING_BASE_URL=https://ai.wust.edu.cn/gpustack/v1
DENSE_EMBEDDING_API_KEY=
DENSE_EMBEDDING_MODEL=qwen3-embedding-4b
DENSE_EMBEDDING_TIMEOUT_SEC=120
DENSE_EMBEDDING_VERIFY_SSL=true
DENSE_EMBEDDING_DEVICE=

# Optional external academic search API. Disabled by default so offline
# evaluation does not depend on public network availability.
ACADEMIC_SEARCH_ENABLED=false
ACADEMIC_SEARCH_PROVIDER=semantic_scholar
ACADEMIC_SEARCH_BASE_URL=https://api.semanticscholar.org/graph/v1
ACADEMIC_SEARCH_API_KEY=
ACADEMIC_SEARCH_TIMEOUT_SEC=8
ACADEMIC_SEARCH_QUERY_LIMIT=2
ACADEMIC_SEARCH_TOP_K=20
ACADEMIC_SEARCH_SNIPPET_ENABLED=true
ACADEMIC_SEARCH_SNIPPET_TOP_K=30
ACADEMIC_SEARCH_MAX_RETRIES=2
ACADEMIC_SEARCH_RETRY_BACKOFF_SEC=1
ACADEMIC_SEARCH_MIN_INTERVAL_SEC=1
ACADEMIC_SEARCH_CACHE_SIZE=256
ACADEMIC_SEARCH_CACHE_PATH=

# Remote model services used by scholar_app/cost_control_cache.
MODEL_SERVICES_ENABLED=true
MODEL_SERVICE_TIMEOUT_SEC=8

QUERY_INTENT_ENABLED=true
QUERY_INTENT_SERVICE_URL=http://10.99.24.182:22436
QUERY_INTENT_MODE=auto

QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_BASE_URL=https://ai.wust.edu.cn/gpustack/v1
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_MODEL=qwen3-30b-a3b-instruct
QUERY_REWRITE_MAX_REWRITES=5
QUERY_REWRITE_MAX_TOKENS=1024
QUERY_REWRITE_TIMEOUT_SEC=20
QUERY_REWRITE_VERIFY_SSL=true
QUERY_REWRITE_CACHE_PATH=cost_control_cache/query_rewrite_cache.json

SELECTOR_RERANKER_ENABLED=true
# Current running selector-reranker pod mounts /data/csp/selector-reranker/model
# into /models/selector-reranker and uses threshold 0.0006931035313755274.
SELECTOR_RERANKER_SERVICE_URL=http://10.99.24.182:32082
SELECTOR_RERANKER_POOL_LIMIT=500
SELECTOR_RERANKER_CANDIDATE_LIMIT=120
SELECTOR_RERANKER_PROTECTED_HEAD=0

CRAWLER_STRATEGY_ENABLED=true
CRAWLER_STRATEGY_SERVICE_URL=http://10.99.24.182:32183
CRAWLER_STRATEGY_TOP_N=3
